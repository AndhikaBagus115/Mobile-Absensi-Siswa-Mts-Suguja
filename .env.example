# Public build configuration only. Copy to .env, then run:
# dart tool/configure_public.dart
# The .env file is NOT bundled in the app.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
APP_ENVIRONMENT=development

# OneSignal Configuration
ONESIGNAL_APP_ID=your-onesignal-app-id-here

# Server secrets belong only in Supabase Edge Function secrets.
# See supabase/backend.env.example and docs/SECURITY_STAGE_2.md.

